{
  "name": "claude-bside",
  "version": "0.2.0",
  "description": "A live listening room where Claude composes Strudel music and the crowd steers it",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import ./src/server/node-hooks.ts src/server/main.ts --dev",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import ./src/server/node-hooks.ts src/server/main.ts",
    "build": "vite build",
    "bside": "node --disable-warning=ExperimentalWarning src/cli/bside.ts",
    "catalog": "node --disable-warning=ExperimentalWarning --import ./src/server/node-hooks.ts scripts/build-catalog.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "acorn": "8.18.0",
    "dotenv": "17.2.3",
    "estree-walker": "3.0.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "worker-timers": "8.0.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "keywords": [
    "music",
    "ai",
    "strudel",
    "claude",
    "live-coding",
    "generative"
  ],
  "license": "AGPL-3.0-or-later"
}
