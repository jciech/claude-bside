# Copy to .env. Everything is optional: without an API key the room runs on the scripted autopilot.

# Lets Claude compose.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Initial composer: claude | scripted | external (default: claude when a key is set, else scripted).
# BSIDE_COMPOSER=scripted
# BSIDE_MODEL=claude-opus-5
# BSIDE_MAX_PLANS_PER_HOUR=90

# Required in production to use the composer API (npm run bside); in development, localhost is allowed without it.
# BSIDE_ADMIN_TOKEN=change-me

# Number of reverse-proxy hops to trust for client addresses (0 = none).
# BSIDE_TRUST_PROXY=0

# PORT=3000
# BSIDE_DATA_DIR=./data
